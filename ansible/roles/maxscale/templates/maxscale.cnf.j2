# {{ ansible_managed }}
# Owner: 김상희 | Project: 石나가는 판단
[maxscale]
threads=auto
log_info=1

[mariadb-01]
type=server
address=192.168.52.40
port=3306

[mariadb-02]
type=server
address=192.168.51.40
port=3306

[MariaDB-Monitor]
type=monitor
module=mariadbmon
servers=mariadb-01,mariadb-02
user=maxscale_monitor
password={{ maxscale_monitor_password }}
monitor_interval=2s
auto_failover=true
auto_rejoin=true
enforce_simple_topology=true
enforce_read_only_slaves=true
replication_user=repl_user
replication_password={{ repl_user_password }}

[Read-Write-Service]
type=service
router=readwritesplit
servers=mariadb-01,mariadb-02
user=maxscale_monitor
password={{ maxscale_monitor_password }}

[Read-Write-Listener]
type=listener
service=Read-Write-Service
port=3306
ssl=true
ssl_cert={{ maxscale_cert_path }}
ssl_key={{ maxscale_key_path }}
ssl_version=MAX
