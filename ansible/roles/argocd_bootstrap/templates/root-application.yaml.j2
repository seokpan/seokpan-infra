# Root Application(App-of-Apps) — seokpan-gitops apps/root 참조 #
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ root_application_name }}
  namespace: {{ root_application_namespace }}
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: {{ root_application_project }}
  source:
    repoURL: {{ gitops_repo_url }}
    targetRevision: {{ gitops_repo_revision }}
    path: {{ gitops_root_path }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ argocd_namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
