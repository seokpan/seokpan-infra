#!/usr/bin/env bash
# Owner: 김상희 / Scope: Data, Storage & Recovery / Project: 石나가는 판단
# Purpose: cron으로 주기 실행되는 MariaDB Full 백업 + NFS 전송 + Retention 스크립트
#          - Replica(읽기 전용) 대상으로 백업 실행 (I/O 부하를 Master 쓰기 경로에서 분리)
#          - auto_failover=true 환경 + MaxScale이 read_only를 런타임 관리하므로
#            매 실행 시 로컬 값을 직접 확인. failover 전환 중일 수 있어 즉시 판정하지 않고
#            일정 간격으로 재확인(최대 대기 시간 경과 시 그날은 이 서버에서 종료)
#          - 마지막 백업 이후 GTID 변경이 없으면 백업 자체를 스킵(동일 데이터 재백업 방지)
#          - NFS Export가 로컬에 마운트되어 있어 SSH 없이 로컬 복사로 전송
#          - Retention은 날짜 기준. 백업 스킵 여부와 무관하게 매 실행마다 적용

set -euo pipefail

CRED_FILE="{{ backup_transfer_credentials_file }}"
SOCKET="{{ mariadb_socket_path }}"
LOCAL_BASE_DIR="{{ backup_transfer_local_base_dir }}"
NFS_MOUNT="{{ backup_transfer_nfs_mount_point }}"
RETENTION_DAYS={{ backup_transfer_retention_days }}
LOG_DIR="{{ backup_transfer_log_dir }}"
STATE_FILE="{{ backup_transfer_state_file }}"
MAX_RETRIES={{ backup_transfer_role_stabilize_max_retries }}
RETRY_INTERVAL={{ backup_transfer_role_stabilize_retry_interval_seconds }}
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_DIR="${LOCAL_BASE_DIR}/full_${TIMESTAMP}"

mkdir -p "${LOG_DIR}"

log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

mysql_exec() {
  mysql --defaults-extra-file="${CRED_FILE}" --socket="${SOCKET}" -N -B -e "$1"
}

apply_retention() {
  find "${LOCAL_BASE_DIR}" -maxdepth 1 -type d -name 'full_*' -mtime "+${RETENTION_DAYS}" -exec rm -rf {} \;
  log "로컬 Retention 적용 완료 (${RETENTION_DAYS}일 초과 백업 삭제)"

  find "${NFS_MOUNT}" -maxdepth 1 -type d -name 'full_*' -mtime "+${RETENTION_DAYS}" -exec rm -rf {} \;
  log "NFS Retention 적용 완료 (${RETENTION_DAYS}일 초과 백업 삭제)"
}

# 0. NFS 마운트 상태 확인 (마운트가 끊겨 있으면 백업 자체를 진행하지 않음)
if ! mountpoint -q "${NFS_MOUNT}"; then
  log "NFS 마운트(${NFS_MOUNT})가 끊겨 있습니다. 백업을 중단합니다."
  exit 1
fi

# 1. Replica(읽기 전용) 상태 안정화 대기
ROLE_CONFIRMED_REPLICA=false
for attempt in $(seq 1 "${MAX_RETRIES}"); do
  READ_ONLY=$(mysql_exec "SHOW GLOBAL VARIABLES LIKE 'read_only';" | awk '{print $2}')

  if [ "${READ_ONLY}" = "ON" ]; then
    log "read_only=ON (시도 ${attempt}/${MAX_RETRIES}) — 이 서버는 현재 Replica로 판단, 백업을 진행합니다."
    ROLE_CONFIRMED_REPLICA=true
    break
  fi

  log "read_only=OFF (시도 ${attempt}/${MAX_RETRIES}) — 이 서버는 현재 Master로 판단."
  if [ "${attempt}" -lt "${MAX_RETRIES}" ]; then
    log "failover 전환 가능성을 고려해 ${RETRY_INTERVAL}초 후 재확인합니다."
    sleep "${RETRY_INTERVAL}"
  fi
done

if [ "${ROLE_CONFIRMED_REPLICA}" != "true" ]; then
  log "최대 대기 시간(${MAX_RETRIES}회 x ${RETRY_INTERVAL}초) 동안 계속 Master로 확인됨."
  log "오늘 백업은 실제 Replica인 다른 서버에서 진행될 것으로 판단, 이 서버는 종료합니다."
  exit 0
fi

# 2. Retention은 백업 성공/스킵 여부와 무관하게 매 실행마다 먼저 적용
#    (GTID 변경 없어 백업이 스킵되는 날이 이어져도 오래된 백업은 계속 정리되어야 함)
apply_retention

# 3. 마지막 백업 이후 변경 여부 확인 (GTID 위치 비교)
CURRENT_GTID=$(mysql_exec "SELECT @@gtid_slave_pos;" | tail -n 1)

if [ -f "${STATE_FILE}" ]; then
  LAST_GTID=$(cat "${STATE_FILE}")
  if [ "${CURRENT_GTID}" = "${LAST_GTID}" ]; then
    log "마지막 백업 이후 GTID 변경 없음 (${CURRENT_GTID}) — 백업을 스킵합니다."
    exit 0
  fi
  log "GTID 변경 감지: ${LAST_GTID} -> ${CURRENT_GTID} — 백업을 진행합니다."
else
  log "이전 백업 기록 없음 (최초 실행) — Full 백업을 진행합니다."
fi

mkdir -p "${BACKUP_DIR}"

# 4. Full 백업
mariadb-backup --defaults-extra-file="${CRED_FILE}" --backup \
  --socket="${SOCKET}" --target-dir="${BACKUP_DIR}" >> "${LOG_DIR}/mariadb_backup.log" 2>&1

# 5. Prepare
mariadb-backup --prepare --target-dir="${BACKUP_DIR}" >> "${LOG_DIR}/mariadb_backup.log" 2>&1

# 6. Checksum
cd "${BACKUP_DIR}"
find . -type f ! -name 'SHA256SUMS' -exec sha256sum {} \; > SHA256SUMS
cd - > /dev/null

log "로컬 백업 완료: ${BACKUP_DIR}"

# 7. NFS 마운트 경로로 전송 (Export가 로컬에 마운트되어 있어 SSH 불필요)
mkdir -p "${NFS_MOUNT}/full_${TIMESTAMP}"
rsync -a "${BACKUP_DIR}/" "${NFS_MOUNT}/full_${TIMESTAMP}/" >> "${LOG_DIR}/mariadb_backup.log" 2>&1

log "NFS 전송 완료: ${NFS_MOUNT}/full_${TIMESTAMP}"

# 8. 백업 성공 후에만 GTID 상태 갱신
echo "${CURRENT_GTID}" > "${STATE_FILE}"

log "백업 작업 전체 완료"
