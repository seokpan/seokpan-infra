[Unit]
# Owner: 김상희
# Scope: Data, Storage & Recovery
# Project: 石나가는 판단(Seokpan)
# Purpose: DR-02(#176) 검증용 격리 etcd systemd unit (STEP 10~11)
# 최초 작성 시간: 2026-09-14
# 수정 시간: 2026-09-14 (버그 수정 — initial-cluster-state existing → new.
#            snapshot으로부터 3-member를 동시에 새로 부팅하는 것이므로
#            "이미 있는 클러스터에 합류"가 아니라 "새 클러스터 형성"이 맞음.
#            existing으로 두면 다른 멤버 응답을 무한 대기하다 타임아웃 발생)
Description=DR-02 Isolated etcd Verification Node ({{ dr_my_member.name }})
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
TimeoutStartSec=30
ExecStart={{ etcd_tools_path }}/etcd \
  --name {{ dr_my_member.name }} \
  --data-dir {{ restore_data_dir }} \
  --initial-cluster {{ dr_initial_cluster }} \
  --initial-cluster-token {{ dr_shared_cluster_token }} \
  --initial-cluster-state new \
  --listen-peer-urls http://{{ dr_my_member.ip }}:{{ etcd_peer_port }} \
  --initial-advertise-peer-urls http://{{ dr_my_member.ip }}:{{ etcd_peer_port }} \
  --listen-client-urls http://{{ dr_my_member.ip }}:{{ etcd_client_port }},http://127.0.0.1:{{ etcd_client_port }} \
  --advertise-client-urls http://{{ dr_my_member.ip }}:{{ etcd_client_port }}
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
