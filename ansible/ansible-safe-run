def fingerprint(root, extra=()):
    result={}
    collection_root=(root/'.ansible/collections').resolve()

    for directory in (
        'inventory','playbooks','roles','collections','.ansible/collections',
        'library','module_utils','action_plugins','callback_plugins',
        'connection_plugins','filter_plugins','inventory_plugins',
        'lookup_plugins','vars_plugins'
    ):
        base=root/directory
        if not base.exists():
            continue

        # 최상위 참조 디렉터리 자체가 symlink인 경우는 계속 차단한다.
        if base.is_symlink():
            stop('참조 트리의 최상위 디렉터리 심볼릭 링크는 허용하지 않습니다.')

        for p in base.rglob('*'):
            # Runtime caches/editor temporaries are not Ansible source inputs.
            if {'__pycache__','.cache','.git'} & set(p.parts):
                continue
            if p.suffix in {'.pyc','.pyo','.retry','.swp','.tmp'} or p.name.endswith(('~','.bak')):
                continue

            if p.is_symlink():
                # 일반 프로젝트 영역의 symlink는 계속 fail-closed.
                if not p.is_relative_to(collection_root):
                    stop('Collection 외부 참조 트리의 심볼릭 링크는 허용하지 않습니다.')

                try:
                    link_text=os.readlink(p)
                except OSError:
                    stop('Collection 심볼릭 링크 정보를 읽을 수 없습니다.')

                # 확인된 kubernetes.core 구조처럼 상대 symlink만 허용.
                if Path(link_text).is_absolute():
                    stop('Collection 내부의 절대경로 심볼릭 링크는 허용하지 않습니다.')

                try:
                    target=p.resolve(strict=True)
                except (FileNotFoundError, RuntimeError, OSError):
                    stop('Collection 내부에 깨졌거나 해석할 수 없는 심볼릭 링크가 있습니다.')

                # 링크 최종 목적지는 반드시 동일 Collection tree 안에 있어야 한다.
                if not target.is_relative_to(collection_root):
                    stop('Collection 심볼릭 링크가 Collection tree 밖을 가리킵니다.')

                # 디렉터리/장치 등이 아니라 실제 파일만 허용한다.
                if not target.is_file():
                    stop('Collection 심볼릭 링크의 최종 대상이 일반 파일이 아닙니다.')

                # 링크 문자열 자체가 바뀌는 경우도 fingerprint 변화로 감지한다.
                result[str(p)+'::symlink']=hashlib.sha256(
                    link_text.encode('utf-8','surrogateescape')
                ).hexdigest()

                # 링크가 가리키는 실제 파일 내용 변경도 감지한다.
                result[str(p)+'::target']=hashlib.sha256(
                    target.read_bytes()
                ).hexdigest()

                continue

            if p.is_file():
                result[str(p)]=hashlib.sha256(p.read_bytes()).hexdigest()

    for p in (root/'ansible.cfg',*extra):
        result[str(p)]=hashlib.sha256(p.read_bytes()).hexdigest()

    return result
def worker(fn):
    """Fork/anonymous pipe only; no exec of credential/extra-var values, no timer."""
    global CHILD
    r,w=os.pipe(); pid=os.fork()
    if not pid:
        os.close(r); os.setsid()
        signal.signal(signal.SIGTERM,signal.SIG_DFL)
        signal.signal(signal.SIGINT,signal.SIG_DFL)
        with open(os.devnull,'wb') as sink:
            os.dup2(sink.fileno(),1); os.dup2(sink.fileno(),2)
        try: response={'ok':True,'data':fn()}
        except NeedVault: response={'need_vault':True}
        except Stop as ex: response={'error':str(ex)}
        except BaseException: response={'error':'Ansible 해석/검증 실패. 상세 값은 민감 정보 보호를 위해 숨깁니다.'}
        with os.fdopen(w,'w') as pipe: json.dump(response,pipe)
        os._exit(0)
    CHILD=pid; os.close(w)
    try:
        with os.fdopen(r) as pipe: data=pipe.read()
        _,status=os.waitpid(pid,0); CHILD=None
        if status or not data: stop('검증 프로세스 비정상 종료')
        return json.loads(data)
    finally:
        if CHILD:
            try: os.killpg(pid,signal.SIGTERM)
            except ProcessLookupError: pass
            os.waitpid(pid,0); CHILD=None

def reviewed_check_override(root, task):
    """Require commit blob, working file, source line, name and action evidence."""
    location=str(task.get_path())
    raw,separator,line_text=location.rpartition(':')
    if not separator or not line_text.isdigit(): return False
    path=Path(raw).resolve()
    if not path.is_relative_to(root) or not path.is_file(): return False
    rel=path.relative_to(root).as_posix()
    evidence=REVIEWED_CHECK_FALSE.get(rel)
    if not evidence: return False
    commit=subprocess.run(['git','-C',str(root),'cat-file','-e',
                           f'{REVIEW_BASE_COMMIT}^{{commit}}'],
                          stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    if commit.returncode: return False
    prefix=subprocess.run(['git','-C',str(root),'rev-parse','--show-prefix'],
                          stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,text=True)
    if prefix.returncode: return False
    git_rel=f"{prefix.stdout.strip().rstrip('/')}/{rel}" if prefix.stdout.strip() else rel
    reviewed=subprocess.run(['git','-C',str(root),'show',f'{REVIEW_BASE_COMMIT}:{git_rel}'],
                            stdout=subprocess.PIPE,stderr=subprocess.DEVNULL)
    if reviewed.returncode: return False
    if hashlib.sha256(reviewed.stdout).hexdigest()!=evidence['sha256']: return False
    if hashlib.sha256(path.read_bytes()).hexdigest()!=evidence['sha256']: return False
    data=task.get_ds() if hasattr(task,'get_ds') else None
    name=data.get('name') if isinstance(data,dict) else None
    return (int(line_text),name,task.action.split('.')[-1]) in evidence['tasks']

