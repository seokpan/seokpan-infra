class Stop(BaseException): pass
class NeedVault(BaseException): pass
def stop(s): raise Stop(s)
def prompt(s, secret=False):
    with open('/dev/tty', 'r') as tty_in, open('/dev/tty', 'w') as tty_out:
        if secret:
            return getpass.getpass(s, stream=tty_out)
        tty_out.write(s)
        tty_out.flush()
        line = tty_in.readline()
        if not line:
            stop('입력 종료: 취소')
        return line.rstrip('\r\n')
def run_keyctl(*arguments):
    options={
        'stdout':subprocess.PIPE,
        'stderr':subprocess.PIPE,
        'stdin':subprocess.DEVNULL,
        'env':KEYCTL_ENV,
        'close_fds':True,
        'start_new_session':True,
        'check':False,
        'shell':False,
    }
    try:
        result=subprocess.run(
            [KEYCTL,*(str(argument) for argument in arguments)],
            **options,
        )
    except OSError:
        stop(
            'Kernel Keyring Credential 조회 실패: '
            'tools/credential-init 상태를 확인하세요.'
        )
    if result.returncode != 0:
        stop(
            'Kernel Keyring Credential 조회 실패: '
            'tools/credential-init을 먼저 실행하세요.'
        )
    return result.stdout

def parse_key_id(raw):
    token=raw.strip()
    if re.fullmatch(rb'[1-9][0-9]{0,9}',token) is None:
        stop('Kernel Keyring Key ID 형식 오류')
    key_id=int(token)
    if not 0 < key_id <= 0x7fffffff:
        stop('Kernel Keyring Key ID 범위 오류')
    return key_id

def describe_key(key_id):
    raw=run_keyctl('rdescribe',key_id)
    if raw.endswith(b'\n'):
        raw=raw[:-1]

    fields=raw.split(b';',4)
    if len(fields)!=5:
        stop('Kernel Keyring 항목 정보 형식 오류')

    key_type,owner,group,permissions,description=fields

    if (
        not key_type
        or re.fullmatch(rb'[0-9]{1,10}',owner) is None
        or re.fullmatch(rb'-?[0-9]{1,10}',group) is None
        or re.fullmatch(rb'[0-9a-fA-F]{1,8}',permissions) is None
    ):
        stop('Kernel Keyring 항목 정보 검증 실패')

    return key_type,int(owner),int(permissions,16),description

def require_owned_key(key_id,uid,key_type,description=None):
    actual_type,owner,permissions,actual_description=describe_key(key_id)

    if actual_type!=key_type or owner!=uid:
        stop('Kernel Keyring 소유자 또는 Key 종류 검증 실패')

    if description is not None and actual_description!=description:
        stop('Kernel Keyring Key 이름 검증 실패')

    return permissions

def ring_ids(ring_id,uid):
    require_owned_key(ring_id,uid,b'keyring')

    ids=tuple(
        parse_key_id(token)
        for token in run_keyctl('rlist',ring_id).split()
    )

    if len(ids)!=len(set(ids)):
        stop('Kernel Keyring 중복 Key ID 감지')

    return frozenset(ids)

def find_direct_key(ring_id,uid,key_type,name):
    expected_name=name.encode('ascii')
    before=ring_ids(ring_id,uid)
    matches=[]

    for key_id in before:
        actual_type,owner,_permissions,description=describe_key(key_id)

        if description!=expected_name:
            continue

        if actual_type!=key_type or owner!=uid:
            stop('Kernel Keyring 항목 소유자 검증 실패')

        matches.append(key_id)

    if before!=ring_ids(ring_id,uid) or len(matches)>1:
        stop('Kernel Keyring 상태 변경 또는 중복 Credential 감지')

    if not matches:
        return None

    key_id=matches[0]

    searched_id=parse_key_id(
        run_keyctl('search',ring_id,key_type.decode('ascii'),name)
    )

    if searched_id!=key_id:
        stop('Kernel Keyring 검색 결과 불일치')

    require_owned_key(key_id,uid,key_type,expected_name)

    if before!=ring_ids(ring_id,uid):
        stop('Kernel Keyring 조회 중 상태 변경 감지')

    return key_id

def validate_execution_user():
    uid=os.getuid()
    euid=os.geteuid()

    if uid==0 or euid==0 or uid!=euid:
        stop('허용된 일반 계정(ansible/jth/ksh/cyj)으로 직접 실행해야 합니다.')

    if os.getresuid()!=(uid,uid,uid):
        stop('sudo/setuid 형태로 ansible-safe-run을 실행할 수 없습니다.')

    if os.getgid()!=os.getegid():
        stop('실제 GID와 유효 GID가 다른 상태에서는 ansible-safe-run을 실행할 수 없습니다.')

    if any(name.startswith('SUDO_') for name in os.environ):
        stop('sudo를 통한 ansible-safe-run 실행은 허용하지 않습니다.')

    try:
        account=pwd.getpwuid(uid)
    except KeyError:
        stop('현재 Linux 계정을 확인할 수 없습니다.')

    if account.pw_name not in ALLOWED_USERS:
        stop('허용된 일반 계정(ansible/jth/ksh/cyj)으로 직접 실행해야 합니다.')

    return uid

def validate_keyctl():
    try:
        info=os.stat(KEYCTL)
    except OSError:
        stop('/usr/bin/keyctl 상태를 확인할 수 없습니다.')

    if (
        not stat.S_ISREG(info.st_mode)
        or not os.access(KEYCTL,os.X_OK)
        or info.st_uid!=0
        or info.st_mode & (stat.S_IWGRP|stat.S_IWOTH)
        or info.st_mode & (stat.S_ISUID|stat.S_ISGID)
    ):
        stop('/usr/bin/keyctl 소유권 또는 권한 검증 실패')

def supply_credential(kind):
    name=CREDENTIAL_KEYS.get(kind)

    if name is None:
        stop('지원하지 않는 Credential 종류')

    uid=os.getuid()

    persistent=parse_key_id(
        run_keyctl('get_persistent','@s')
    )
    require_owned_key(persistent,uid,b'keyring')

    child=find_direct_key(
        persistent,uid,b'keyring',CREDENTIAL_RING_NAME
    )

    if child is None:
        stop(
            'Kernel Keyring Credential 미등록: '
            'tools/credential-init을 먼저 실행하세요.'
        )

    permissions=require_owned_key(
        child,
        uid,
        b'keyring',
        CREDENTIAL_RING_NAME.encode('ascii'),
    )

    if permissions & 0x0000ffff:
        stop(
            'Credential Keyring의 group/other 권한이 열려 있어 '
            '사용을 중단합니다.'
        )

    key_id=find_direct_key(
        child,uid,b'user',name
    )

    if key_id is None:
        stop(
            '필요한 Kernel Keyring Credential이 없습니다: '
            'tools/credential-init을 다시 실행하세요.'
        )

    permissions=require_owned_key(
        key_id,
        uid,
        b'user',
        name.encode('ascii'),
    )

    if permissions & 0x0000ffff:
        stop(
            'Credential Key의 group/other 권한이 열려 있어 '
            '사용을 중단합니다.'
        )

    payload=run_keyctl('pipe',key_id)

    if not payload:
        stop('Kernel Keyring Credential 값이 비어 있습니다.')

    try:
        value=payload.decode('utf-8')
    except UnicodeDecodeError:
        stop('Kernel Keyring Credential 문자 인코딩 검증 실패')

    if not value:
        stop('Kernel Keyring Credential 값이 비어 있습니다.')

    return value

def enforce_playbook_policy(name):
    if name in UNSUPPORTED_SPECIAL_TESTS:
        stop('특수 CA mutation 테스트는 generic ansible-safe-run에서 실행할 수 없습니다.')
    if name in MANUAL_ONLY:
        stop('DB Operator Playbook은 tools/db-operator-login의 수동 --ask-vault-pass 경로를 사용해야 합니다.')
def cancel(sig, frame):
    if CHILD:
        try: os.killpg(CHILD,signal.SIGTERM)
        except ProcessLookupError: pass
    raise KeyboardInterrupt
def resolve(root, name):
    p=Path(name)
    if '..' in p.parts or any(ord(c)<32 for c in name): stop('경로 탈출/제어 문자 차단')
    if not p.is_absolute(): p=root/p if p.parts[0]=='playbooks' else root/'playbooks'/p
    p=p.resolve()
    if not p.is_relative_to(root/'playbooks') or not p.is_file() or not p.stat().st_size:
        stop('playbooks/ 하위의 비어 있지 않은 일반 파일이 필요합니다.')
    return p
