                        # notifies it. Never use it to request a credential in probe.
                        if is_handler: conn.close(); continue
                        if mode not in ('probe','probe_become') or not new_row: conn.close(); continue
                        try:
                            if transport!='local':
                                rc,out,err=conn.exec_command('id -un',sudoable=False)
                                if rc or out.decode().strip()!=user:
                                    stop('SSH 접속이 준비되지 않았습니다. 별도 SSH Bootstrap 작업을 먼저 수행하세요.')
                            if mode=='probe_become' and become:
                                if become.name.split('.')[-1]!='sudo': stop('이 Become 방식의 인증 probe가 정의되지 않았습니다.')
                                command=become.build_become_command('id -un',conn._shell)
                                try: rc,out,err=conn.exec_command(command,sudoable=True)
                                except Exception as ex:
                                    message=str(ex); encoded=message.encode('utf-8','replace')
                                    if not secrets.get('become') and (
                                        become.check_missing_password(encoded) or
                                        'Missing sudo password' in message or
                                        'sudo: 암호가 필요합니다' in message):
                                        need=True; continue
                                    raise
                                if rc:
                                    if not secrets.get('become') and become.check_missing_password(out+err): need=True; continue
                                    stop('Become probe 실패: 비밀번호 필요로 추측하지 않고 중단합니다.')
                                lines=[x.strip() for x in out.decode().splitlines() if x.strip()]
                                if not lines or lines[-1]!=target: stop('Become 후 실제 사용자 불일치')
                        finally: conn.close()
    if not records: stop('Ansible이 선택한 대상/작업이 없습니다.')
    if risk and any(row not in records for row in handler_records):
        stop('위험 Playbook의 잠재 Handler가 별도 접속/권한 구조를 사용하여 실행 전 Credential을 확정할 수 없습니다.')
    if pb.name=='mariadb_dr_recovery.yml':
        tags=set(context.CLIARGS['tags'])
        if not context.CLIARGS['subset'] or len({r['host'] for r in records})!=1 or len(tags)!=1 or not tags<={'restore','replication','maxscale_verify','checklist'}:
            stop('DR은 -l 대상 1개와 단계 태그 1개가 필요합니다.')
    return {'targets':records,'potential_handlers':handler_records,'risk':risk,
            'unknown_check':sorted(set(unknown)),'need_become':need}

def main():
    resource.setrlimit(resource.RLIMIT_CORE,(0,0))
    signal.signal(signal.SIGINT,cancel); signal.signal(signal.SIGTERM,cancel)
    validate_execution_user()
    validate_keyctl()
    root=Path(sys.argv[1]).resolve()
    args=[os.fsdecode(v) for v in sys.stdin.buffer.read().split(b'\0')[:-1]]
    if not args: stop('Playbook 인자 누락')
    pb=resolve(root,args[0]); args,inspect,private_prompt=validate_user_args(args[1:])
    enforce_playbook_policy(pb.name)
    secrets={}; private={}; auth_state={'vault_required':False}
    if private_prompt:
        private=json.loads(prompt('민감한 추가 변수 JSON (표시/저장 안 함): ',True))
        if not isinstance(private,dict): stop('JSON 객체가 필요합니다.')
        for key in private: validate_var_key(str(key),secret_input=True)
    os.chdir(root)
    pb_rel=pb.relative_to(root).as_posix()
    p=subprocess.run(['git','ls-files','--error-unmatch','--',pb_rel],capture_output=True)
    if p.returncode: print('경고: Git 추적 여부 미확인')
    p=subprocess.run(['git','status','--porcelain','--',pb_rel],capture_output=True)
    if p.stdout: print('경고: 커밋되지 않은 Playbook 변경')
    files=[]
    baseline=fingerprint(root,files)
    def run(mode):
        if fingerprint(root,files)!=baseline: stop('검증 중 파일 변경: 처음부터 다시 검사하세요.')
        response=worker(lambda:engine(root,pb,args,secrets,private,mode))
        if response.get('need_vault'):
            # Vault need is monotonic for the whole preflight.  A later native
            # include/probe/check may be the first phase that decrypts data.
            auth_state['vault_required']=True
            if secrets.get('vault'): stop('Vault 인증/해석 실패')
            secrets['vault']=supply_credential('vault')
            response=worker(lambda:engine(root,pb,args,secrets,private,mode))
        if not response.get('ok'): stop(response.get('error','Vault 인증/해석 실패'))
        return response['data']
    print('========================================\nAnsible Playbook 실행 사전 검사\n========================================')
    print('Playbook          :',pb.relative_to(root))
    run('syntax')
    print('Syntax Check      : 성공')
    plan=run('inspect')
    for r in plan['targets']:
        print('실행 대상/위임    :',r['host'],'/',r['delegate'] or '없음')
        print('실행 방식/사용자  :',r['connection'],'/',r['user'])
        print('Become 사용/대상  :',r['become'],'/',r['become_user'])
    for r in plan['potential_handlers']:
        print('잠재 Handler 구조 :',r['host'],'/',r['delegate'] or '없음',
              '/',r['connection'],'/',r['user'],'/ Become',r['become'],'→',r['become_user'])
    if plan['unknown_check']:
        print('Check 판정 불가   :', len(plan['unknown_check']), '개 Task (미검토 check_mode:false)')
        for item in plan['unknown_check']:
            print('  -', item)
        print('조치              : 위 Task의 실제 동작을 사람이 검토한 뒤 안전한 Task만 Evidence에 등록해야 합니다.')
    if inspect:
        print('접속 상태         : 검사 안 함 (--inspect-only)')
        print('Vault 인증        :','필요·검증 완료' if auth_state['vault_required'] else '불필요')
        print('Become 비밀번호   : 판정 안 함')
        print('필요 Credential\n- Vault           :','필요' if auth_state['vault_required'] else '불필요')
        print('- Become          : 판정 안 함')
        print('Check Mode 결과   : 실행 안 함'); return 0
    if plan['unknown_check']: stop('Check Mode 안전성 판정 불가: 실제 실행을 금지합니다.')
    result=run('probe')
    if (result['targets']!=plan['targets'] or
            result['potential_handlers']!=plan['potential_handlers']):
        stop('검사 사이 대상/권한 변경')
    print('접속 상태         : 검증 완료 (local은 SSH 제외)')
    if plan['risk']:
        result=run('probe_become')
        if (result['targets']!=plan['targets'] or
                result['potential_handlers']!=plan['potential_handlers']):
            stop('검사 사이 대상/권한 변경')
        if result['need_become']:
            secrets['become']=supply_credential('become')
            result=run('probe_become')
            if (result['need_become'] or result['targets']!=plan['targets'] or
                    result['potential_handlers']!=plan['potential_handlers']):
                stop('Become 재검증 실패')
        check_result='자동 생략 (운영 영향 Evidence)'
        print('이 Playbook은 Check Mode에서도 운영 영향 가능성이 있어 자동 사전 실행을 생략합니다.')
    else:
        checked=run('check')
        if checked.get('need_become'):
            secrets['become']=supply_credential('become')
            checked=run('check')
            if checked.get('need_become'): stop('Become 재검증 실패')
        check_result='성공'
    print('Vault 인증        :','필요·검증 완료' if auth_state['vault_required'] else '불필요')
    print('Become 비밀번호   :','필요·검증 완료' if secrets.get('become') else '불필요 (runtime 검사 성공)')
    print('필요 Credential\n- Vault           :','필요' if auth_state['vault_required'] else '불필요')
    print('- Become          :','필요' if secrets.get('become') else '불필요')
    print('Check Mode 결과   :',check_result)
    print('실행 명령         : ansible-playbook',pb.relative_to(root),'[추가 옵션 값 숨김; 인증은 메모리 전달]')
    if plan['risk'] and prompt('위험 확인: APPLY '+pb.name+' 을 정확히 입력: ')!='APPLY '+pb.name:
        print('취소했습니다.'); return 0
    if prompt('실제 Playbook을 적용하시겠습니까? [y/N] ') not in ('y','yes'):
        print('취소했습니다.'); return 0
    run('apply'); print('실제 실행 완료'); return 0

if __name__=='__main__':
    try: raise SystemExit(main())
    except Stop as ex: print('중단:',str(ex),file=sys.stderr); raise SystemExit(2)
    except KeyboardInterrupt:
        print('중단했습니다. 적용 중이었다면 이미 발생한 변경은 자동 복구되지 않습니다.',file=sys.stderr); raise SystemExit(130)
    except Exception:
        print('중단: 입력/환경/해석 오류. 민감 정보 보호를 위해 상세 값은 출력하지 않습니다.',file=sys.stderr); raise SystemExit(2)
PYTHON
exec "$root/.venv/bin/python" -I -c "$runner_code" "$root" < <(printf '%s\0' "${args[@]}")

