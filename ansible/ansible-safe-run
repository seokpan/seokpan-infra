def validate_var_key(key, secret_input=False):
    if not VAR_NAME.fullmatch(key): stop('Extra Var 이름은 단순 변수명이어야 합니다.')
    if key.startswith('ansible_') or key in CONTROL_VARS:
        stop('추가 변수로 연결·권한·Inventory 제어값을 바꾸는 것은 허용하지 않습니다.')
    if not secret_input and SENSITIVE_KEY.search(key):
        stop('Password/Secret/Token/Private Key/Credential 계열 변수는 --secret-extra-vars로 입력하세요.')
def validate_user_args(args):
    """Lexical allow-list only; Ansible still performs the semantic parse."""
    clean=[]; inspect=False; private_prompt=False; i=0
    short={'-l':'limit','-t':'tags','-e':'extra'}
    long={'--limit':'limit','--tags':'tags','--skip-tags':'skip','--extra-vars':'extra'}
    while i<len(args):
        arg=args[i]
        if arg=='--inspect-only':
            if inspect: stop('--inspect-only 중복 지정')
            inspect=True; i+=1; continue
        if arg=='--secret-extra-vars':
            if private_prompt: stop('--secret-extra-vars 중복 지정')
            private_prompt=True; i+=1; continue
        kind=None; value=None
        if arg in short or arg in long:
            kind=(short|long)[arg]
            if i+1>=len(args) or args[i+1].startswith('-'): stop(arg+' 값이 필요합니다.')
            value=args[i+1]; clean.extend((arg,value)); i+=2
        elif any(arg.startswith(opt+'=') for opt in long):
            option,value=arg.split('=',1); kind=long[option]
            if not value: stop(option+' 값이 필요합니다.')
            clean.append(arg); i+=1
        else:
            stop('지원하지 않는 Ansible 옵션이 포함되어 있습니다.')
        if kind=='extra':
