#!/usr/bin/env bash

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    printf '%s\n' '이 스크립트는 source로 실행할 수 없습니다.' >&2
    return 2
fi

set +x
set +v
set -Eeuo pipefail
umask 077

if (( $# != 0 )); then
    printf '%s\n' \
        '사용법: ./tools/credential-init' \
        'Credential 값은 명령행 인자로 전달하지 마세요.' >&2
    exit 2
fi

ANSIBLE_ROOT="$(
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P
)" || {
    printf '%s\n' '프로젝트 경로를 확인할 수 없습니다.' >&2
    exit 2
}

readonly ANSIBLE_ROOT
readonly PROJECT_PYTHON="$ANSIBLE_ROOT/.venv/bin/python"

if [[ ! -f "$PROJECT_PYTHON" || ! -x "$PROJECT_PYTHON" ]]; then
    printf '%s\n' '프로젝트 Python을 실행할 수 없습니다.' >&2
    exit 2
fi

exec "$PROJECT_PYTHON" -I -B - <<'PYTHON'
import resource
import sys

try:
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
except (OSError, ValueError):
    sys.stderr.write("Core dump를 비활성화할 수 없습니다.\n")
    sys.exit(1)

import getpass
import hmac
import os
import pwd
import re
import signal
import socket
import stat
import subprocess
import termios
import warnings


KEYCTL = "/usr/bin/keyctl"
ALLOWED_USERS = frozenset({"ansible", "jth", "ksh", "cyj"})
RING_NAME = "s_sh_credentials"
KEY_NAMES = ("s_sh_vault", "s_sh_become")
OWNER_ONLY_PERMISSIONS = "0x003f0000"

KEYCTL_ENV = {
    "PATH": "/usr/bin:/bin",
    "LC_ALL": "C",
    "LANG": "C",
}

transaction_active = False
pending_signal = None


class CredentialError(Exception):
    pass


class Cancelled(CredentialError):
    pass


class RollbackError(CredentialError):
    pass


def handle_signal(signum, _frame):
    global pending_signal
    pending_signal = signum
    if not transaction_active:
        raise Cancelled()


def check_cancelled():
    if pending_signal is not None:
        raise Cancelled()


for handled_signal in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
    signal.signal(handled_signal, handle_signal)


def run_keyctl(*arguments, payload=None):
    options = {
        "stdout": subprocess.PIPE,
        "stderr": subprocess.PIPE,
        "env": KEYCTL_ENV,
        "close_fds": True,
        "start_new_session": True,
        "check": False,
        "shell": False,
    }

    if payload is None:
        options["stdin"] = subprocess.DEVNULL
    else:
        options["input"] = payload

    try:
        result = subprocess.run(
            [KEYCTL, *(str(argument) for argument in arguments)],
            **options,
        )
    except OSError:
        raise CredentialError() from None

    if result.returncode != 0:
        raise CredentialError()

    return result.stdout


def parse_key_id(raw):
    token = raw.strip()

    if re.fullmatch(rb"[1-9][0-9]{0,9}", token) is None:
        raise CredentialError()

    key_id = int(token)
    if not 0 < key_id <= 0x7FFFFFFF:
        raise CredentialError()

    return key_id


def describe(key_id):
    raw = run_keyctl("rdescribe", key_id)
    if raw.endswith(b"\n"):
        raw = raw[:-1]

    fields = raw.split(b";", 4)
    if len(fields) != 5:
        raise CredentialError()

    key_type, owner, group, permissions, description = fields

    if (
        not key_type
        or re.fullmatch(rb"[0-9]{1,10}", owner) is None
        or re.fullmatch(rb"-?[0-9]{1,10}", group) is None
        or re.fullmatch(rb"[0-9a-fA-F]{1,8}", permissions) is None
    ):
        raise CredentialError()

    return key_type, int(owner), int(permissions, 16), description


def require_owned(key_id, uid, key_type, description=None):
    actual_type, owner, permissions, actual_description = describe(key_id)

    if actual_type != key_type or owner != uid:
        raise CredentialError()

    if description is not None and actual_description != description:
        raise CredentialError()

    return permissions


def ring_ids(ring_id, uid):
    require_owned(ring_id, uid, b"keyring")
    ids = tuple(
        parse_key_id(token)
        for token in run_keyctl("rlist", ring_id).split()
    )

    if len(ids) != len(set(ids)):
        raise CredentialError()

    return frozenset(ids)


def find_direct(ring_id, uid, key_type, name):
    # search 실패를 "없음"으로 해석하지 않는다.
    # 부모의 직접 링크와 모든 설명을 정상적으로 읽었을 때만
    # 대상의 부재를 인정한다. 접근 오류와 불명확한 상태는 중단한다.
    expected_name = name.encode("ascii")
    before = ring_ids(ring_id, uid)
    matches = []

    for key_id in before:
        actual_type, owner, _permissions, description = describe(key_id)

        if description != expected_name:
            continue

        if actual_type != key_type or owner != uid:
            raise CredentialError()

        matches.append(key_id)

    if before != ring_ids(ring_id, uid) or len(matches) > 1:
        raise CredentialError()

    if not matches:
        return None

    key_id = matches[0]

    # 직접 링크에서 찾은 대상은 실제 검색도 성공해야 한다.
    # non-zero 결과는 stderr 내용과 관계없이 오류로 취급한다.
    searched_id = parse_key_id(
        run_keyctl("search", ring_id, key_type.decode("ascii"), name)
    )

    if searched_id != key_id:
        raise CredentialError()

    require_owned(key_id, uid, key_type, expected_name)

    if before != ring_ids(ring_id, uid):
        raise CredentialError()

    return key_id


def validate_user():
    uid = os.getuid()
    euid = os.geteuid()

    if uid == 0 or euid == 0 or uid != euid:
        raise CredentialError()

    if os.getresuid() != (uid, uid, uid):
        raise CredentialError()

    if os.getgid() != os.getegid():
        raise CredentialError()

    if any(name.startswith("SUDO_") for name in os.environ):
        raise CredentialError()

    try:
        account = pwd.getpwuid(uid)
    except KeyError:
        raise CredentialError() from None

    if account.pw_name not in ALLOWED_USERS:
        raise CredentialError()

    return uid


def validate_keyctl():
    info = os.stat(KEYCTL)

    if (
        not stat.S_ISREG(info.st_mode)
        or not os.access(KEYCTL, os.X_OK)
        or info.st_uid != 0
        or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
        or info.st_mode & (stat.S_ISUID | stat.S_ISGID)
    ):
        raise CredentialError()


def read_credentials():
    fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY | os.O_CLOEXEC)

    try:
        if not os.isatty(fd):
            raise CredentialError()

        termios.tcgetattr(fd)

        # 출력 전용 wrapper는 비탐색 장치인 /dev/tty에도 사용할 수 있다.
        # 실제 hidden 입력은 getpass가 직접 /dev/tty를 열어 수행한다.
        tty = os.fdopen(fd, "w", encoding="utf-8", buffering=1)
        fd = None

        with tty:
            with warnings.catch_warnings():
                # TTY 입력 실패 시 echo 입력으로 fallback하지 않는다.
                warnings.simplefilter("error", getpass.GetPassWarning)
                vault = getpass.getpass("Vault password: ", stream=tty)
                become = getpass.getpass("Become password: ", stream=tty)

            if not vault or not become:
                raise CredentialError()

            payloads = {
                "s_sh_vault": vault.encode("utf-8"),
                "s_sh_become": become.encode("utf-8"),
            }
            del vault, become
            return payloads

    finally:
        if fd is not None:
            os.close(fd)


def acquire_lock(uid):
    # 동일 도구의 동시 실행을 파일 없이 직렬화한다.
    # 별도 도구의 변경까지 차단하지는 않으므로 별도로 상태를 검증한다.
    lock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)

    try:
        lock.bind("\0seokpan-infra.credential-init." + str(uid))
    except OSError:
        lock.close()
        raise CredentialError() from None

    return lock


class Transaction:
    def __init__(self, uid, payloads):
        self.uid = uid
        self.payloads = payloads
        self.persistent = None
        self.child = None
        self.child_creation_attempted = False
        self.baseline = None
        self.original_ids = {}
        self.snapshots = {}
        self.journal = []
        self.final_ids = {}

    def verify_child_link(self):
        actual = find_direct(
            self.persistent, self.uid, b"keyring", RING_NAME
        )
        if actual != self.child:
            raise CredentialError()

    def execute(self):
        check_cancelled()

        # 다른 UID 인자를 전달하지 않는다.
        self.persistent = parse_key_id(
            run_keyctl("get_persistent", "@s")
        )
        require_owned(self.persistent, self.uid, b"keyring")
        check_cancelled()

        self.child = find_direct(
            self.persistent, self.uid, b"keyring", RING_NAME
        )

        if self.child is None:
            check_cancelled()
            self.child_creation_attempted = True

            self.child = parse_key_id(
                run_keyctl("newring", RING_NAME, self.persistent)
            )
            require_owned(
                self.child, self.uid, b"keyring", RING_NAME.encode("ascii")
            )
            self.verify_child_link()

            if ring_ids(self.child, self.uid):
                raise CredentialError()

            run_keyctl("setperm", self.child, OWNER_ONLY_PERMISSIONS)

        permissions = require_owned(
            self.child, self.uid, b"keyring", RING_NAME.encode("ascii")
        )
        if permissions & 0x0000FFFF:
            raise CredentialError()

        self.verify_child_link()
        self.baseline = ring_ids(self.child, self.uid)

        # 두 기존 payload를 모두 읽은 후에 Credential 변경을 시작한다.
        for name in KEY_NAMES:
            key_id = find_direct(self.child, self.uid, b"user", name)
            self.original_ids[name] = key_id

            if key_id is not None:
                permissions = require_owned(
                    key_id, self.uid, b"user", name.encode("ascii")
                )
                if permissions & 0x0000FFFF:
                    raise CredentialError()

                self.snapshots[name] = run_keyctl("pipe", key_id)

        if ring_ids(self.child, self.uid) != self.baseline:
            raise CredentialError()

        for name in KEY_NAMES:
            check_cancelled()
            self.verify_child_link()

            key_id = self.original_ids[name]

            if find_direct(self.child, self.uid, b"user", name) != key_id:
                raise CredentialError()

            if key_id is not None:
                if not hmac.compare_digest(
                    run_keyctl("pipe", key_id), self.snapshots[name]
                ):
                    raise CredentialError()

            # 명령의 결과가 불확실해져도 복원을 시도하도록 먼저 기록한다.
            entry = {
                "name": name,
                "old_id": key_id,
                "new_id": None,
            }
            self.journal.append(entry)

            if key_id is None:
                key_id = parse_key_id(
                    run_keyctl(
                        "padd", "user", name, self.child,
                        payload=self.payloads[name],
                    )
                )
                entry["new_id"] = key_id

                require_owned(
                    key_id, self.uid, b"user", name.encode("ascii")
                )
                run_keyctl("setperm", key_id, OWNER_ONLY_PERMISSIONS)
            else:
                run_keyctl(
                    "pupdate", key_id, payload=self.payloads[name]
                )

            self.final_ids[name] = key_id

            if find_direct(self.child, self.uid, b"user", name) != key_id:
                raise CredentialError()

            if not hmac.compare_digest(
                run_keyctl("pipe", key_id), self.payloads[name]
            ):
                raise CredentialError()

        expected = frozenset(
            set(self.baseline) | set(self.final_ids.values())
        )

        self.verify_child_link()

        if ring_ids(self.child, self.uid) != expected:
            raise CredentialError()

        for name in KEY_NAMES:
            key_id = find_direct(self.child, self.uid, b"user", name)

            if key_id != self.final_ids[name]:
                raise CredentialError()

            if not hmac.compare_digest(
                run_keyctl("pipe", key_id), self.payloads[name]
            ):
                raise CredentialError()

        check_cancelled()

    def rollback_entry(self, entry):
        name = entry["name"]
        old_id = entry["old_id"]
        current_id = find_direct(self.child, self.uid, b"user", name)

        if old_id is not None:
            if current_id != old_id:
                raise RollbackError()

            current = run_keyctl("pipe", old_id)
            previous = self.snapshots[name]

            if not (
                hmac.compare_digest(current, previous)
                or hmac.compare_digest(current, self.payloads[name])
            ):
                # 외부에서 변경한 것으로 보이는 값을 덮어쓰지 않는다.
                raise RollbackError()

            run_keyctl("pupdate", old_id, payload=previous)

            if not hmac.compare_digest(
                run_keyctl("pipe", old_id), previous
            ):
                raise RollbackError()

            return

        new_id = entry["new_id"]

        if new_id is None:
            if current_id is not None:
                # 생성 응답을 확인하지 못한 키를 임의로 삭제하지 않는다.
                raise RollbackError()
            return

        if current_id != new_id:
            raise RollbackError()

        if not hmac.compare_digest(
            run_keyctl("pipe", new_id), self.payloads[name]
        ):
            raise RollbackError()

        run_keyctl("unlink", new_id, self.child)

        if find_direct(self.child, self.uid, b"user", name) is not None:
            raise RollbackError()

    def rollback(self):
        failed = False

        if self.child is None:
            if self.child_creation_attempted:
                try:
                    found = find_direct(
                        self.persistent, self.uid, b"keyring", RING_NAME
                    )
                    if found is not None:
                        # 생성 여부와 ID를 확정할 수 없는 대상을 삭제하지 않는다.
                        raise RollbackError()
                except Exception:
                    raise RollbackError() from None
            return

        for entry in reversed(self.journal):
            try:
                self.rollback_entry(entry)
            except Exception:
                failed = True

        if self.child_creation_attempted:
            try:
                self.verify_child_link()

                if ring_ids(self.child, self.uid):
                    raise RollbackError()

                run_keyctl("unlink", self.child, self.persistent)

                if find_direct(
                    self.persistent, self.uid, b"keyring", RING_NAME
                ) is not None:
                    raise RollbackError()
            except Exception:
                failed = True

        elif self.journal:
            try:
                self.verify_child_link()

                if ring_ids(self.child, self.uid) != self.baseline:
                    raise RollbackError()

                for name in KEY_NAMES:
                    key_id = find_direct(
                        self.child, self.uid, b"user", name
                    )

                    if key_id != self.original_ids[name]:
                        raise RollbackError()

                    if key_id is not None and not hmac.compare_digest(
                        run_keyctl("pipe", key_id), self.snapshots[name]
                    ):
                        raise RollbackError()
            except Exception:
                failed = True

        if failed:
            raise RollbackError()


def main():
    global transaction_active

    payloads = {}
    lock = None
    transaction = None

    try:
        uid = validate_user()
        validate_keyctl()

        # 두 입력의 검증이 끝나기 전에는 Keyring 명령을 호출하지 않는다.
        payloads = read_credentials()
        check_cancelled()

        lock = acquire_lock(uid)
        check_cancelled()

        transaction = Transaction(uid, payloads)
        transaction_active = True

        try:
            transaction.execute()
        except BaseException:
            try:
                transaction.rollback()
            except BaseException:
                raise RollbackError() from None
            raise

        transaction_active = False

        sys.stdout.write(
            "Credential 등록 완료: 현재 사용자의 Kernel Keyring에 "
            "Vault/Become 값을 저장했습니다.\n"
            "평문 Credential 파일은 생성하지 않았습니다.\n"
        )
        sys.stdout.flush()
        return 0

    except RollbackError:
        sys.stderr.write(
            "Credential 등록 실패 후 rollback 상태를 완전히 보장할 수 없습니다.\n"
            "실제 Credential을 사용하지 말고 Keyring 상태를 점검해야 합니다.\n"
        )
        return 1

    except (Cancelled, KeyboardInterrupt, EOFError):
        sys.stderr.write("Credential 등록이 취소되었습니다.\n")
        return 1

    except (
        CredentialError,
        OSError,
        UnicodeError,
        ValueError,
        getpass.GetPassWarning,
        termios.error,
    ):
        sys.stderr.write(
            "Credential 등록에 실패했습니다. "
            "실행 계정, TTY 및 Keyring 접근 상태를 확인하세요.\n"
        )
        return 1

    except Exception:
        sys.stderr.write(
            "Credential 등록 중 예상하지 못한 오류가 발생했습니다.\n"
        )
        return 1

    finally:
        transaction_active = False

        # 참조를 해제하지만 Python 메모리의 완전한 소거를 보장하지는 않는다.
        if transaction is not None:
            transaction.snapshots.clear()
            transaction.payloads.clear()

        payloads.clear()

        if lock is not None:
            lock.close()


try:
    exit_code = main()
except BaseException:
    try:
        os.write(2, "Credential 처리를 완료하지 못했습니다.\n".encode("utf-8"))
    except OSError:
        pass
    exit_code = 1

sys.exit(exit_code)
PYTHON
